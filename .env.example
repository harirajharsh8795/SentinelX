# ==============================================================================
# SentinelX Environment Configuration Template
# Copy this to backend/.env and fill in your actual values.
# NEVER commit the real .env file to version control.
# ==============================================================================

# --- Core Secrets (REQUIRED) ---
SECRET_KEY=your-random-secret-key-here-min-32-chars
GEMINI_API_KEY=your-gemini-api-key-here

# --- Database ---
DATABASE_URL=sqlite:///./sentinel_v2.db

# --- Ollama (Local SLM) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# --- Storage Paths ---
CHROMA_PERSIST_DIR=./vector_store
UPLOAD_DIR=./uploads
CORPUS_DIR=./data/corpus

# --- Application Settings ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5200
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SCRAPING_ENABLED=true
SCRAPE_INTERVAL_HOURS=12
AUTO_SEED_CORPUS=true
